{
  "version": "0.1.8",
  "scripts": {
    "checks:push": "bash .github/scripts/run-local-push-checks.sh",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:unit": "npm run test:unit:python && npm run test:unit:js && npm run test:unit:ruby",
    "test:unit:python": "python3 -m unittest discover -s tests",
    "test:unit:js": "node --test tests/js/*.test.js",
    "test:unit:ruby": "bundle exec ruby -Itest test/run_all.rb",
    "test:lighthouse": "bash .github/scripts/run-lighthouse.sh",
    "test:ui": "playwright test",
    "dev": "bash bin/entry_point.sh",
    "build": "JEKYLL_ENV=production bundle exec jekyll build && npm run css:purge",
    "css:purge": "node .github/scripts/purge-page-css.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@shopify/prettier-plugin-liquid": "1.4.0",
    "lighthouse": "^13.4.1",
    "prettier": "3.8.1",
    "purgecss": "^8.0.0"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
