{% assign img_path = include.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' | remove: '.webp' %}
{% assign parts = include.path | split: '.' %}
{% assign ext = parts.last %}

<figure
  class="content-figure{% if include.figure_class %} {{ include.figure_class }}{% endif %}"
  {% if include.slot %}
    slot="{{ include.slot }}"
  {% endif %}
>
  <picture>
    <!-- Auto scaling with imagemagick -->
    <!--
      See https://www.debugbear.com/blog/responsive-images#w-descriptors-and-the-sizes-attribute and
      https://developer.mozilla.org/en-US/docs/Learn/HTML/Multimedia_and_embedding/Responsive_images for info on defining 'sizes' for responsive images
    -->
    {% if site.imagemagick.enabled %}
      <source
        class="responsive-img-srcset"
        {% if ext == 'gif' or ext == 'jpeg' or ext == 'jpg' or ext == 'png' or ext == 'tiff' or ext == 'webp' %}
          srcset="{% for i in site.imagemagick.widths %}{{ img_path | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
          type="image/webp"
        {% else %}
          srcset="{{ include.path | relative_url }}"
        {% endif %}
        {% if include.sizes %}
          sizes="{{ include.sizes }}"
        {% elsif include.width %}
          sizes="(max-width: {{ include.width }}px) 95vw, {{ include.width }}px"
        {% else %}
          sizes="95vw"
        {% endif %}
      >
    {% endif %}
    <img
      data-responsive-image
      src="{% if include.url %}{{ include.url }}{% elsif include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width }}"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% endif %}
      {% if include['min-width'] or include['min-height'] or include['max-width'] or include['max-height'] %}
        style="
          {% if include['min-width'] %}
            min-width: {{ include.min-width }};
          {% endif %}
          {% if include['min-height'] %}
            min-height: {{ include.min-height }};
          {% endif %}
          {% if include['max-width'] %}
            max-width: {{ include.max-width }};
          {% endif %}
          {% if include['max-height'] %}
            max-height: {{ include.max-height }};
          {% endif %}
        "
      {% endif %}
      {% if include.alt %}
        alt="{{ include.alt }}"
      {% endif %}
      {% if include.title %}
        title="{{ include.title }}"
      {% endif %}
      {% if include.zoomable %}
        data-zoomable
      {% endif %}
      {% if include.loading %}
        loading="{{ include.loading }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      {% if include.fetchpriority %}
        fetchpriority="{{ include.fetchpriority }}"
      {% endif %}
      {% if include.decoding %}
        decoding="{{ include.decoding }}"
      {% endif %}
      onerror="this.onerror=null; this.closest('picture')?.querySelector('.responsive-img-srcset')?.remove();"
    >
  </picture>

  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
