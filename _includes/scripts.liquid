{% assign load_publication_badges = false %}
{% if page.page_id == 'publications' or page.selected_papers or page.related_publications %}
  {% assign load_publication_badges = true %}
{% endif %}
{% assign lazy_publication_badges = false %}
{% if page.page_id == 'publications' %}
  {% assign lazy_publication_badges = true %}
{% endif %}

<!-- Badges -->
{% if load_publication_badges and site.enable_publication_badges.altmetric and lazy_publication_badges == false %}
  <script async src="https://d1bxh8uas1mnw7.cloudfront.net/assets/embed.js"></script>
{% endif %}
{% if load_publication_badges and site.enable_publication_badges.dimensions and lazy_publication_badges == false %}
  <script async src="https://badge.dimensions.ai/badge.js"></script>
{% endif %}

{% assign load_mathjax = false %}
{% if site.enable_math %}
  {% if page.math == true or page.enable_math == true or page.tikzjax or page.pseudocode %}
    {% assign load_mathjax = true %}
  {% elsif page.content %}
    {% if page.content contains '$$' or page.content contains '\(' or page.content contains '\[' or page.content contains '\begin{' %}
      {% assign load_mathjax = true %}
    {% endif %}
  {% endif %}
{% endif %}

{% if load_mathjax %}
  <!-- MathJax -->
  <script
    defer
    type="text/javascript"
    id="MathJax-script"
    src="{{ site.third_party_libraries.mathjax.url.js }}"
    integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  {% unless page.pseudocode %}
    <script defer src="{{ '/assets/js/mathjax-setup.js' | relative_url | bust_file_cache }}"></script>
    <script
      defer
      src="{{ site.third_party_libraries.polyfill.url.js }}"
      crossorigin="anonymous"
    ></script>
  {% else %}
    <script defer src="{{ '/assets/js/pseudocode-setup.js' | relative_url | bust_file_cache }}"></script>
    <script
      defer
      type="text/javascript"
      src="{{ site.third_party_libraries.pseudocode.url.js }}"
      integrity="{{ site.third_party_libraries.pseudocode.integrity.js }}"
      crossorigin="anonymous"
    ></script>
  {% endunless %}
{% endif %}

{% if site.enable_google_analytics %}
  <!-- Analytics -->
  <!-- Queue analytics immediately, then download gtag after the page load so it does not compete with LCP assets. -->
  <script defer src="{{ '/assets/js/google-analytics-setup.js' | relative_url | bust_file_cache }}"></script>
  <script defer src="{{ '/assets/js/analytics-events.js' | relative_url | bust_file_cache }}"></script>
  <script>
    window.addEventListener(
      'load',
      function loadGoogleAnalytics() {
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}';
        document.head.appendChild(script);
      },
      { once: true }
    );
  </script>
{% endif %}

{% if site.enable_cronitor_analytics %}
  <!-- Cronitor RUM -->
  <script async src="https://rum.cronitor.io/script.js"></script>
  <script defer src="{{ '/assets/js/cronitor-analytics-setup.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if site.enable_pirsch_analytics %}
  <script
    defer
    src="https://api.pirsch.io/pa.js"
    id="pianjs"
    data-code="{{ site.pirsch_analytics }}"
  ></script>
{% endif %}
{% if site.enable_openpanel_analytics %}
  <script defer src="{{ '/assets/js/open-panel-analytics-setup.js' | relative_url | bust_file_cache }}"></script>
  <script async defer src="https://openpanel.dev/op1.js"></script>
{% endif %}

{% if site.enable_progressbar %}
