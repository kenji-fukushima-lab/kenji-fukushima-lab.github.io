  <script>
    addBackToTop();
  </script>
{% endif %}

{% if site.search_enabled %}
  <!-- Search -->
  {% if site.active_lang == 'ja' %}
    {% assign search_dialog_label = 'サイト内検索' %}
    {% assign search_close_label = '検索を閉じる' %}
  {% else %}
    {% assign search_dialog_label = 'Search this site' %}
    {% assign search_close_label = 'Close search' %}
  {% endif %}
  <div id="pagefind-modal-shell" class="pagefind-modal-shell" hidden aria-hidden="true">
    <div class="pagefind-modal-shell__backdrop" data-pagefind-close></div>
    <div
      class="pagefind-modal-shell__dialog"
      role="dialog"
      aria-modal="true"
      aria-label="{{ search_dialog_label }}"
      tabindex="-1"
    >
      <button
        type="button"
        class="pagefind-modal-shell__close"
        data-pagefind-close
        aria-label="{{ search_close_label }}"
      >
        <span aria-hidden="true">&times;</span>
      </button>
      <div id="pagefind-search" class="pagefind-search-root" aria-live="polite"></div>
    </div>
  </div>
  <script defer src="{{ '/assets/js/search-setup.js' | relative_url | bust_file_cache }}"></script>
  <script defer src="{{ '/assets/js/shortcut-key.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if site.newsletter.enabled %}
  <script defer src="{{ '/assets/js/newsletter.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
